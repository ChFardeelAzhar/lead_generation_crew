{
  "name": "lead_generation_crew",
  "agents": [
    "maps_scraper",
    "data_enricher"
  ],
  "tasks": [
    {
      "name": "scrape_maps_task",
      "description": "Search for 5 {category} in {location}. Extract company name, address, phone number, and website.",
      "expected_output": "A list of 5 businesses with their details.",
      "agent": "maps_scraper"
    },
    {
      "name": "enrich_data_task",
      "description": "Take the output from scrape_maps_task. Visit the websites to find Owner's Name and Email. IMPORTANT: Do NOT attempt to scrape or visit social media links (e.g., instagram.com, facebook.com, linkedin.com). Only extract data from official company websites.",
      "expected_output": "A CSV formatted list containing: Company Name, Owner's Name, Address, Email, Contact number, Website URL.",
      "agent": "data_enricher"
    }
  ]
}